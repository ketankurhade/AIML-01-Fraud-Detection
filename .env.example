# ==============================================================================
# Environment Configuration - Real-Time Fraud Detection Platform
# ==============================================================================

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=fraud.transactions.raw
KAFKA_TOPIC_ALERTS=fraud.alerts.detected
KAFKA_CONSUMER_GROUP=fraud-scoring-group

# Feast Feature Store
FEAST_REPO_PATH=./features

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=realtime-fraud-detection

# FastAPI Scoring Service
API_HOST=0.0.0.0
API_PORT=8000
MODEL_TYPE=ensemble # options: xgboost, pyg, ensemble

# Evidently Monitoring
MONITORING_WINDOW_SIZE=1000
REFERENCE_DATA_PATH=data/paysim_sample.csv
DRIFT_REPORT_DIR=services/monitoring/reports

# Vue Dashboard Frontend
VITE_API_BASE_URL=http://localhost:8000

